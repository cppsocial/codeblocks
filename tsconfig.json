{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* Linting */
    "strict": true,
    "noFallthroughCasesInSwitch": true,
  },
  "include": [
    "src/runtime.ts",
    "src/ansi.ts",
    "src/fallback.ts",
    "src/codeblocks.ts",
    "src/runtime/**/*.ts",
    "src/config.ts",
    "src/json_stream.ts",
    "src/vite-env.d.ts"
  ],
}
