{
  "name": "@cppsocial/codeblocks",
  "private": true,
  "version": "0.1.2",
  "description": "Editable C++ code blocks backed by Monaco and clangd WebAssembly",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cppsocial/codeblocks.git"
  },
  "type": "module",
  "types": "./dist/types/codeblocks.d.ts",
  "files": [
    "dist/**/*",
    "!dist/index.html",
    "!dist/_headers"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/codeblocks.d.ts",
      "import": "./dist/codeblocks-module.js"
    },
    "./loader": {
      "types": "./dist/loader.d.ts",
      "default": "./dist/codeblocks.js"
    },
    "./styles.css": "./dist/codeblocks.css"
  },
  "scripts": {
    "clean": "node scripts/build-package.mjs --clean",
    "dev": "node scripts/dev.mjs",
    "watch": "tsc -w",
    "build": "node scripts/build-package.mjs",
    "build:hosted": "node scripts/build-package.mjs --outdir=dist-hosted --without-wasm",
    "prepare": "node scripts/clangd/ensure-wasm.mjs && npm run build",
    "package:npm": "node scripts/prepare-npm-package.mjs dist packages/codeblocks @cppsocial/codeblocks",
    "package:npm:hosted": "node scripts/prepare-npm-package.mjs dist-hosted packages/codeblocks-hosted @cppsocial/codeblocks-hosted",
    "pack:runtime": "pnpm build && bash scripts/package-runtime.sh",
    "release:wasm": "bash scripts/clangd/release-wasm.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "tsc --noEmit && prettier --check .",
    "check": "pnpm lint && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@types/emscripten": "^1.39.10",
    "@types/node": "~20.12.12",
    "@types/vscode": "~1.89.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.6.2",
    "typescript": "^5.4.5",
    "vite": "^5.4.8",
    "vitest": "^2.1.9"
  },
  "dependencies": {
    "@codingame/esbuild-import-meta-url-plugin": "~1.0.2",
    "@codingame/monaco-vscode-configuration-service-override": "~8.0.4",
    "@codingame/monaco-vscode-cpp-default-extension": "~8.0.4",
    "@codingame/monaco-vscode-textmate-service-override": "~8.0.4",
    "@codingame/monaco-vscode-theme-service-override": "~8.0.4",
    "microlighter": "^2.1.0",
    "monaco-editor": "npm:@codingame/monaco-vscode-editor-api@~8.0.4",
    "monaco-editor-wrapper": "~5.5.3",
    "monaco-languageclient": "~8.8.3",
    "vscode": "npm:@codingame/monaco-vscode-api@~8.0.4",
    "vscode-languageserver": "~9.0.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "0.21.5"
    }
  },
  "packageManager": "pnpm@9.1.1",
  "volta": {
    "node": "20.13.1",
    "pnpm": "9.1.1"
  }
}
